{
  "ConnectionStrings": {
    "GestaoEventos": "Host=localhost;Port=5432;Database=gestao_eventos;Username=gestao;Password=gestao;Maximum Pool Size=100;Include Error Detail=true"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "gestao-eventos",
    "Audience": "gestao-eventos",
    "SigningKey": "",
    "ExpirationMinutes": 480
  },
  "Identidade": {
    "AdministradorInicial": {
      "Email": "admin@gestaoeventos.local",
      "Nome": "Administrador",
      "Senha": ""
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalMs": 2000,
    "BatchSize": 50,
    "LockSeconds": 60,
    "MaxAttempts": 10
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
